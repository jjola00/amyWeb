[
  {
    "fields": [
      {
        "validation": [
          {
            "rules": [
              {
                "flag": "presence",
                "constraint": "required"
              }
            ],
            "level": "error"
          }
        ],
        "description": "What do you want to call this artwork?",
        "name": "title",
        "type": "string",
        "title": "Name of Drawing"
      },
      {
        "options": {
          "hotspot": true,
          "metadata": [
            "blurhash",
            "lqip",
            "palette"
          ],
          "storeOriginalFilename": false
        },
        "validation": [
          {
            "rules": [
              {
                "flag": "presence",
                "constraint": "required"
              }
            ],
            "level": "error"
          }
        ],
        "fields": [
          {
            "placeholder": "Digital illustration of...",
            "validation": [
              {
                "rules": [
                  {
                    "flag": "presence",
                    "constraint": "required"
                  }
                ],
                "level": "error"
              }
            ],
            "description": "Briefly describe what this artwork shows (e.g., \"Digital illustration of a pink-haired character\")",
            "name": "alt",
            "type": "string",
            "title": "Alt text (for accessibility)"
          }
        ],
        "name": "image",
        "type": "image",
        "title": "Upload Image"
      },
      {
        "weak": true,
        "options": {
          "disableNew": false
        },
        "validation": [
          {
            "rules": [
              {
                "flag": "presence",
                "constraint": "required"
              }
            ],
            "level": "error"
          }
        ],
        "description": "Select existing or create new category inline",
        "to": [
          {
            "type": "category"
          }
        ],
        "name": "category",
        "type": "reference",
        "title": "Tag/Category"
      },
      {
        "rows": 3,
        "description": "Tell us about this artwork (optional)",
        "name": "description",
        "type": "text",
        "title": "Description (Optional)"
      },
      {
        "weak": true,
        "description": "If this is a comic cover, link it to the full comic",
        "to": [
          {
            "type": "comic"
          }
        ],
        "hidden": "conditional",
        "name": "comic",
        "type": "reference",
        "title": "Linked Comic (for Comics category)"
      },
      {
        "options": {
          "source": "title",
          "maxLength": 96
        },
        "validation": [
          {
            "rules": [
              {
                "flag": "custom"
              },
              {
                "flag": "presence",
                "constraint": "required"
              }
            ],
            "level": "error"
          }
        ],
        "description": "Click generate to create the URL slug from the artwork title",
        "name": "slug",
        "type": "slug",
        "title": "URL Slug"
      }
    ],
    "name": "artwork",
    "type": "document"
  },
  {
    "validation": [
      {
        "rules": [
          {
            "flag": "custom"
          }
        ],
        "level": "error"
      }
    ],
    "fields": [
      {
        "validation": [
          {
            "rules": [
              {
                "flag": "presence",
                "constraint": "required"
              }
            ],
            "level": "error"
          }
        ],
        "description": "Type any category name you want",
        "name": "name",
        "type": "string",
        "title": "Category Name"
      },
      {
        "options": {
          "source": "name",
          "maxLength": 96
        },
        "validation": [
          {
            "rules": [
              {
                "flag": "custom"
              },
              {
                "flag": "presence",
                "constraint": "required"
              }
            ],
            "level": "error"
          }
        ],
        "description": "Click generate to create the URL slug from the name",
        "name": "slug",
        "type": "slug",
        "title": "URL Slug"
      },
      {
        "rows": 2,
        "placeholder": "e.g., Digital illustrations, hand-drawn artwork, character designs...",
        "description": "What type of art goes in this category? (optional)",
        "name": "description",
        "type": "text",
        "title": "Description (Optional)"
      }
    ],
    "name": "category",
    "type": "document",
    "title": "Art Categories"
  },
  {
    "fields": [
      {
        "options": {
          "hotspot": true
        },
        "description": "Upload your photo here",
        "fields": [
          {
            "validation": [
              {
                "rules": [
                  {
                    "flag": "presence",
                    "constraint": "required"
                  }
                ],
                "level": "error"
              }
            ],
            "name": "alt",
            "type": "string",
            "title": "Alt text (for accessibility)"
          }
        ],
        "name": "artistPhoto",
        "type": "image"
      },
      {
        "rows": 10,
        "validation": [
          {
            "rules": [
              {
                "flag": "presence",
                "constraint": "required"
              }
            ],
            "level": "error"
          }
        ],
        "description": "Tell people about yourself and your art",
        "name": "artistBio",
        "type": "text",
        "title": "About You"
      },
      {
        "validation": [
          {
            "rules": [
              {
                "flag": "presence",
                "constraint": "required"
              }
            ],
            "level": "error"
          }
        ],
        "description": "How should people call you?",
        "name": "artistName",
        "type": "string",
        "title": "Your Name"
      },
      {
        "description": "Where are you based? (e.g., Dublin, Ireland)",
        "name": "location",
        "type": "string"
      }
    ],
    "name": "aboutPage",
    "type": "document"
  },
  {
    "fields": [
      {
        "validation": [
          {
            "rules": [
              {
                "flag": "presence",
                "constraint": "required"
              },
              {
                "flag": "max",
                "constraint": 100
              }
            ],
            "level": "error"
          }
        ],
        "description": "The name of the event (e.g., \"Art Exhibition Opening\", \"Comic Con 2024\")",
        "name": "name",
        "type": "string",
        "title": "Event Name"
      },
      {
        "options": {
          "source": "name",
          "maxLength": 96
        },
        "validation": [
          {
            "rules": [
              {
                "flag": "custom"
              },
              {
                "flag": "presence",
                "constraint": "required"
              }
            ],
            "level": "error"
          }
        ],
        "description": "URL-friendly version of the event name",
        "name": "slug",
        "type": "slug"
      },
      {
        "validation": [
          {
            "rules": [
              {
                "flag": "presence",
                "constraint": "required"
              }
            ],
            "level": "error"
          }
        ],
        "description": "When the event takes place (date only)",
        "name": "date",
        "type": "date",
        "title": "Event Date"
      },
      {
        "options": {
          "list": [
            {
              "title": "Upcoming",
              "value": "upcoming"
            },
            {
              "title": "Done",
              "value": "done"
            }
          ],
          "layout": "radio"
        },
        "initialValue": "upcoming",
        "validation": [
          {
            "rules": [
              {
                "flag": "valid",
                "constraint": [
                  "upcoming",
                  "done"
                ]
              },
              {
                "flag": "presence",
                "constraint": "required"
              }
            ],
            "level": "error"
          }
        ],
        "description": "Is this event upcoming or already done?",
        "name": "status",
        "type": "string",
        "title": "Event Status"
      },
      {
        "rows": 4,
        "description": "Brief description of the event (optional)",
        "name": "description",
        "type": "text"
      },
      {
        "initialValue": false,
        "description": "Highlight this event on the website",
        "name": "featured",
        "type": "boolean",
        "title": "Featured Event"
      },
      {
        "validation": [
          {
            "rules": [
              {
                "flag": "uri",
                "constraint": {
                  "options": {
                    "scheme": [
                      "/^http$/",
                      "/^https$/"
                    ],
                    "allowRelative": false,
                    "relativeOnly": false,
                    "allowCredentials": false
                  }
                }
              }
            ],
            "level": "error"
          }
        ],
        "description": "Link to event page, tickets, or more information (optional)",
        "name": "externalLink",
        "type": "url"
      },
      {
        "validation": [
          {
            "rules": [
              {
                "flag": "max",
                "constraint": 10
              }
            ],
            "level": "error"
          }
        ],
        "description": "Upload photos (including HEIC) and videos (including MOV) from the event (max 10 items total). Great for showcasing past events!",
        "of": [
          {
            "options": {
              "hotspot": true,
              "metadata": [
                "blurhash",
                "lqip",
                "palette"
              ],
              "storeOriginalFilename": false,
              "accept": "image/*,.heic,.HEIC"
            },
            "fields": [
              {
                "placeholder": "Photo from [event name]...",
                "validation": [
                  {
                    "rules": [
                      {
                        "flag": "presence",
                        "constraint": "required"
                      }
                    ],
                    "level": "error"
                  }
                ],
                "description": "Describe what this photo shows",
                "name": "alt",
                "type": "string",
                "title": "Alt text (for accessibility)"
              },
              {
                "description": "Optional caption to display with the photo",
                "name": "caption",
                "type": "string",
                "title": "Caption (optional)"
              }
            ],
            "type": "image",
            "title": "Photo"
          },
          {
            "options": {
              "accept": "video/*,.mov,.MOV,.mp4,.MP4",
              "storeOriginalFilename": false
            },
            "fields": [
              {
                "placeholder": "Video from [event name]...",
                "validation": [
                  {
                    "rules": [
                      {
                        "flag": "presence",
                        "constraint": "required"
                      }
                    ],
                    "level": "error"
                  }
                ],
                "description": "Describe what this video shows",
                "name": "alt",
                "type": "string",
                "title": "Video description (for accessibility)"
              },
              {
                "description": "Optional caption to display with the video",
                "name": "caption",
                "type": "string",
                "title": "Video Caption (optional)"
              },
              {
                "options": {
                  "hotspot": true,
                  "metadata": [
                    "blurhash",
                    "lqip"
                  ]
                },
                "description": "Custom thumbnail for the video. If not provided, a default play icon will be used.",
                "name": "thumbnail",
                "type": "image",
                "title": "Video Thumbnail (optional)"
              }
            ],
            "type": "file",
            "title": "Video"
          }
        ],
        "name": "media",
        "type": "array",
        "title": "Event Photos & Videos"
      }
    ],
    "name": "event",
    "type": "document"
  },
  {
    "fields": [
      {
        "validation": [
          {
            "rules": [
              {
                "flag": "presence",
                "constraint": "required"
              }
            ],
            "level": "error"
          }
        ],
        "description": "A short label for the shop item (e.g., \"Badge - Pink Cat\")",
        "name": "name",
        "type": "string",
        "title": "Item Label"
      },
      {
        "options": {
          "hotspot": true,
          "metadata": [
            "blurhash",
            "lqip",
            "palette"
          ],
          "storeOriginalFilename": false
        },
        "validation": [
          {
            "rules": [
              {
                "flag": "presence",
                "constraint": "required"
              }
            ],
            "level": "error"
          }
        ],
        "fields": [
          {
            "validation": [
              {
                "rules": [
                  {
                    "flag": "presence",
                    "constraint": "required"
                  }
                ],
                "level": "error"
              }
            ],
            "description": "Short accessible description for the image",
            "name": "alt",
            "type": "string",
            "title": "Alt text"
          }
        ],
        "name": "image",
        "type": "image",
        "title": "Cover Image"
      },
      {
        "validation": [
          {
            "rules": [
              {
                "flag": "uri",
                "constraint": {
                  "options": {
                    "scheme": [
                      "/^http$/",
                      "/^https$/"
                    ],
                    "allowRelative": false,
                    "relativeOnly": false,
                    "allowCredentials": false
                  }
                }
              }
            ],
            "level": "error"
          }
        ],
        "description": "Optional link to the item on an external store (Etsy, etc.)",
        "name": "etsyUrl",
        "type": "url",
        "title": "External Link (optional)"
      },
      {
        "options": {
          "source": "name",
          "maxLength": 96
        },
        "validation": [
          {
            "rules": [
              {
                "flag": "custom"
              },
              {
                "flag": "presence",
                "constraint": "required"
              }
            ],
            "level": "error"
          }
        ],
        "description": "Generate a slug from the item label to publish a page (if needed)",
        "name": "slug",
        "type": "slug",
        "title": "URL Slug"
      }
    ],
    "name": "shopItem",
    "type": "document"
  },
  {
    "fields": [
      {
        "validation": [
          {
            "rules": [
              {
                "flag": "presence",
                "constraint": "required"
              }
            ],
            "level": "error"
          }
        ],
        "description": "Title of this comic (e.g., \"My Adventure Comic\", \"Comic1\")",
        "name": "title",
        "type": "string",
        "title": "Comic Title"
      },
      {
        "options": {
          "source": "title",
          "maxLength": 96
        },
        "validation": [
          {
            "rules": [
              {
                "flag": "custom"
              },
              {
                "flag": "presence",
                "constraint": "required"
              }
            ],
            "level": "error"
          }
        ],
        "description": "Generate a slug from the comic title",
        "name": "slug",
        "type": "slug",
        "title": "URL Slug"
      },
      {
        "rows": 3,
        "description": "Brief description of this comic (optional)",
        "name": "description",
        "type": "text",
        "title": "Comic Description"
      },
      {
        "validation": [
          {
            "rules": [
              {
                "flag": "presence",
                "constraint": "required"
              },
              {
                "flag": "min",
                "constraint": 1
              }
            ],
            "level": "error"
          }
        ],
        "description": "Upload the pages of your comic in order. You can drag to reorder them!",
        "of": [
          {
            "fields": [
              {
                "validation": [
                  {
                    "rules": [
                      {
                        "flag": "presence",
                        "constraint": "required"
                      },
                      {
                        "flag": "min",
                        "constraint": 0
                      }
                    ],
                    "level": "error"
                  }
                ],
                "description": "Order of this page (1, 2, 3, etc.) - you can reorder these!",
                "name": "pageNumber",
                "type": "number"
              },
              {
                "options": {
                  "hotspot": true,
                  "metadata": [
                    "blurhash",
                    "lqip",
                    "palette"
                  ],
                  "storeOriginalFilename": false
                },
                "validation": [
                  {
                    "rules": [
                      {
                        "flag": "presence",
                        "constraint": "required"
                      }
                    ],
                    "level": "error"
                  }
                ],
                "fields": [
                  {
                    "placeholder": "Page showing...",
                    "validation": [
                      {
                        "rules": [
                          {
                            "flag": "presence",
                            "constraint": "required"
                          }
                        ],
                        "level": "error"
                      }
                    ],
                    "description": "Describe what happens on this page",
                    "name": "alt",
                    "type": "string",
                    "title": "Alt text"
                  }
                ],
                "name": "image",
                "type": "image",
                "title": "Page Image"
              },
              {
                "description": "Optional caption or note for this page",
                "name": "caption",
                "type": "string",
                "title": "Page Caption (Optional)"
              }
            ],
            "type": "object",
            "name": "comicPage"
          }
        ],
        "name": "pages",
        "type": "array",
        "title": "Comic Pages"
      },
      {
        "description": "When was this comic created? (optional)",
        "name": "publishedDate",
        "type": "date"
      },
      {
        "initialValue": false,
        "description": "Highlight this comic on the gallery page",
        "name": "featured",
        "type": "boolean",
        "title": "Featured Comic"
      }
    ],
    "name": "comic",
    "type": "document"
  }
]