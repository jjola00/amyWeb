  {
    "fields": [
      {
        "options": {
          "hotspot": true
        },
        "description": "Upload your photo here",
        "fields": [
          {
            "validation": [
              {
                "rules": [
                  {
                    "flag": "presence",
                    "constraint": "required"
                  }
                ],
                "level": "error"
              }
            ],
            "name": "alt",
            "type": "string",
            "title": "Alt text (for accessibility)"
          }
        ],
        "name": "artistPhoto",
        "type": "image"
      },
      {
        "rows": 10,
        "validation": [
          {
            "rules": [
              {
                "flag": "presence",
                "constraint": "required"
              }
            ],
            "level": "error"
          }
        ],
        "description": "Tell people about yourself and your art",
        "name": "artistBio",
        "type": "text",
        "title": "About You"
      },
      {
        "validation": [
          {
            "rules": [
              {
                "flag": "presence",
                "constraint": "required"
              }
            ],
            "level": "error"
          }
        ],
        "description": "How should people call you?",
        "name": "artistName",
        "type": "string",
        "title": "Your Name"
      },
      {
        "description": "Where are you based? (e.g., Dublin, Ireland)",
        "name": "location",
        "type": "string"
      }
    ],
    "name": "aboutPage",
    "type": "document"
  },
  {
    "fields": [
      {
        "validation": [
          {
            "rules": [
              {
                "flag": "presence",
                "constraint": "required"
              },
              {
                "flag": "max",
                "constraint": 100
              }
            ],
            "level": "error"
          }
        ],
        "description": "The name of the event (e.g., \"Art Exhibition Opening\", \"Comic Con 2024\")",
        "name": "name",
        "type": "string",
        "title": "Event Name"
      },
      {
        "options": {
          "source": "name",
          "maxLength": 96
        },
        "validation": [
          {
            "rules": [
              {
                "flag": "custom"
              },
              {
                "flag": "presence",
                "constraint": "required"
              }
            ],
            "level": "error"
          }
        ],
        "description": "URL-friendly version of the event name",
        "name": "slug",
        "type": "slug"
      },
      {
        "validation": [
          {
            "rules": [
              {
                "flag": "presence",
                "constraint": "required"
              }
            ],
            "level": "error"
          }
        ],
        "description": "When the event takes place",
        "name": "date",
        "type": "datetime",
        "title": "Event Date"
      },
      {
        "validation": [
          {
            "rules": [
              {
                "flag": "presence",
                "constraint": "required"
              },
              {
                "flag": "max",
                "constraint": 200
              }
            ],
            "level": "error"
          }
        ],
        "description": "Where the event takes place (e.g., \"Downtown Gallery\", \"Convention Center Hall A\")",
        "name": "location",
        "type": "string"
      },
      {
        "options": {
          "list": [
            {
              "title": "Upcoming",
              "value": "upcoming"
            },
            {
              "title": "Planned",
              "value": "planned"
            },
            {
              "title": "Completed",
              "value": "completed"
            },
            {
              "title": "Cancelled",
              "value": "cancelled"
            }
          ],
          "layout": "radio"
        },
        "initialValue": "planned",
        "validation": [
          {
            "rules": [
              {
                "flag": "valid",
                "constraint": [
                  "upcoming",
                  "planned",
                  "completed",
                  "cancelled"
                ]
              },
              {
                "flag": "presence",
                "constraint": "required"
              }
            ],
            "level": "error"
          }
        ],
        "description": "Current status of the event",
        "name": "status",
        "type": "string",
        "title": "Event Status"
      },
      {
        "rows": 4,
        "description": "Brief description of the event (optional)",
        "name": "description",
        "type": "text"
      },
      {
        "initialValue": false,
        "description": "Highlight this event on the website",
        "name": "featured",
        "type": "boolean",
        "title": "Featured Event"
      },
      {
        "validation": [
          {
            "rules": [
              {
                "flag": "uri",
                "constraint": {
                  "options": {
                    "scheme": [
                      "/^http$/",
                      "/^https$/"
                    ],
                    "allowRelative": false,
                    "relativeOnly": false,
                    "allowCredentials": false
                  }
                }
              }
            ],
            "level": "error"
          }
        ],
        "description": "Link to event page, tickets, or more information (optional)",
        "name": "externalLink",
        "type": "url"
      }
    ],
    "name": "event",
    "type": "document"
  }
]